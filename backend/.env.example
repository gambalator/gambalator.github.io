# Copy this file to backend/.env. Never commit the real token.
GAMBALATOR_DA_ACCESS_TOKEN=

# Optional settings
GAMBALATOR_POLL_INTERVAL_SECONDS=5
GAMBALATOR_IMPORT_EXISTING=false
GAMBALATOR_HOST=127.0.0.1
GAMBALATOR_PORT=5741

# Use "file" only when the operating-system keyring is unavailable. The file
# fallback is private to the local user where the OS supports file permissions,
# but it is not encrypted.
# GAMBALATOR_CREDENTIAL_STORE=file
